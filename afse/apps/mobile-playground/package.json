    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react-dom": "18.3.1",
    "react-native-web": "~0.19.13",
    "vite": "^5.4.11"
  }
}
