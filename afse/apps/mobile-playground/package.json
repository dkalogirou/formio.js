{
  "name": "afse-formio-mobile-playground",
  "private": true,
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "bundle:check": "expo export --platform android --platform ios --output-dir .expo-export",
    "typecheck": "tsc --noEmit",
